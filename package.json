{
  "name": "hub-pessoal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env server/index.js",
    "dev:full": "concurrently -n vite,api -c cyan,magenta \"vite\" \"node --env-file=.env server/index.js\"",
    "start": "npm run build && node --env-file=.env server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "build:apk": "npm run build && npx cap sync && node scripts/build-apk.js",
    "open:android": "npx cap open android",
    "test": "npm run test:core && npm run test:rules && npm run test:finance && npm run test:college && npm run test:sigaa && npm run test:rpg && npm run test:projects && npm run test:ai && npm run test:jarvis",
    "test:college": "node scripts/college-module-check.js",
    "test:sigaa": "node scripts/sigaa-classifier-check.js",
    "test:finance": "node scripts/finance-module-check.js",
    "test:rpg": "node scripts/rpg-module-check.js",
    "test:projects": "node scripts/projects-module-check.js",
    "test:core": "node scripts/core-check.js",
    "test:ai": "node scripts/ai-check.js",
    "test:rules": "node scripts/finance-rules-check.js",
    "projects:status": "node scripts/projects-status.js",
    "test:jarvis": "node --env-file=.env scripts/jarvis-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.2",
    "@fontsource/inter": "^5.2.8",
    "@google-cloud/local-auth": "^3.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "function-plot": "^1.25.4",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "puppeteer": "^25.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.160.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.1",
    "postcss": "^8.5.0",
    "sigaa-api": "^1.0.34",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
