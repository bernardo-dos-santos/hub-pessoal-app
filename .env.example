# Copie para .env (que é ignorado pelo git) e preencha. Só os NOMES ficam no repositório.

# --- Servidor ---
PORT=3001
# 32 bytes em base64. Obrigatória em toda máquina que roda o servidor (criptografa as chaves de IA
# e as credenciais de cada usuário).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# Exigida (Authorization: Bearer) de quem não é localhost nem o tailnet.
HUB_API_KEY=

# --- Endereço do servidor no tailnet (Tailscale), ex.: https://<maquina>.<tailnet>.ts.net ---
# Scripts e atalhos do desktop leem HUB_BACKEND.
HUB_BACKEND=
# Mesmo endereço, lido pelo frontend no build (Vite só expõe variáveis com prefixo VITE_).
VITE_HUB_BACKEND=

# --- Acesso público (opcional): segunda porta, só para o Cloudflare Tunnel ---
# Sem PUBLIC_PORT não existe porta pública. Toda requisição por ela precisa do
# certificado do aparelho, verificado pela Cloudflare.
# PUBLIC_PORT=
# PUBLIC_ORIGIN=https://app.seudominio.com
# Endereço que o APK abre (capacitor.config.ts → server.url), lido no build do APK.
# HUB_PUBLIC_URL=https://app.seudominio.com
# Emissão de certificados pelo painel de usuários (token com acesso a SSL and Certificates da zona).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# --- Notificações (Web Push) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=

# --- Íris (assistente do dono do servidor) ---
ANTHROPIC_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Token do agente local (agent/agent.js) que executa comandos no notebook.
# AGENT_TOKEN=
# Leitura de repositórios no módulo Projetos (fine-grained: Contents + Metadata).
# GITHUB_TOKEN=

# --- Localização usada no clima (padrão: Lages) ---
# HUB_CITY=
# HUB_LAT=
# HUB_LON=
