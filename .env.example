# Copie para .env (que é ignorado pelo git) e preencha. Só os NOMES ficam no repositório.

# --- Servidor ---
PORT=3001
# 32 bytes em base64. Obrigatória em toda máquina que roda o servidor (criptografa as chaves de IA).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Endereço do servidor no tailnet (Tailscale), ex.: https://<maquina>.<tailnet>.ts.net ---
# Scripts, atalhos do desktop e build do APK (capacitor.config.ts) leem HUB_BACKEND.
HUB_BACKEND=
# Mesmo endereço, lido pelo frontend no build (Vite só expõe variáveis com prefixo VITE_).
VITE_HUB_BACKEND=

# --- IA (opcionais; o Jarvis usa a chave do próprio servidor) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OLLAMA_URL=   # só na máquina que realmente roda Ollama

# --- Localização usada no clima (padrão: Lages) ---
# HUB_CITY=
# HUB_LAT=
# HUB_LON=
